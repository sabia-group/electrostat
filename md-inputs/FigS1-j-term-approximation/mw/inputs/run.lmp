
include settings.lmp # time step dt

boundary p p p
units real
timestep ${dt}
# distribute electrode atoms among all processors:
if "$(extract_setting(world_size) % 2) == 0" then "processors * * 2"

atom_style full
pair_style lj/cut/coul/long 15
bond_style harmonic
angle_style harmonic
kspace_style pppm/electrode 1e-7

read_data "equi.data"

group bot type 6
group top type 7
group ele type 6 7

group SPC type 1 2 3
group electrolyte type 1 2 3 4 5

# fix nvt electrolyte nvt temp 298.0 298.0 100
fix nve electrolyte nve

variable q atom q
variable qz atom q*(z-lz/2)
compute qtop top reduce sum v_q
compute qbot bot reduce sum v_q
compute qztop top reduce sum v_qz
compute qzbot bot reduce sum v_qz
compute ctemp electrolyte temp

compute zmax_bot bot reduce max z
compute zmin_top top reduce min z
variable dist equal c_zmin_top-c_zmax_bot
run 0
reset_timestep 0
variable Lx equal lx
variable Ly equal ly
variable Lz equal lz
print "Dim: ${Lx} ${Ly} ${Lz}"
print "Distance: ${dist}"

variable th_temp   equal 298.0                       # temperature [K]
variable th_time   equal 100.0                       # relaxation time thermostat [fs]
variable efield0 equal -2.0/lz
fix fxele ele electrode/efield/thermo ${efield0} eta 1.805132 etypes on qtotal 0 offset_group bot read_inv inv.csv sub_groups bot top temp ${th_temp} ${th_time} 1337 symm_split off
variable efield equal f_fxele[1]
variable de_pol equal f_fxele[2]
variable de_old equal f_fxele[3]
variable de_diff equal v_de_pol-v_de_old

fix shake SPC shake 1e-4 20 0 b 1 2 a 1

thermo 100
thermo_style custom step temp c_ctemp epair etotal c_qtop

variable unit_eV equal 0.043364104241800934
variable s equal step
variable qleft equal c_qbot
variable myTemp equal c_ctemp
variable etot equal etotal
variable ekin equal ke
variable epot equal pe
compute dip_elec ele dipole
variable dip_elec equal c_dip_elec[3]
compute dip_elyt electrolyte dipole
variable dip_elyt equal c_dip_elyt[3]

fix fxprint all print 10 "${s}, ${dt}, ${efield0}, ${efield}, ${qleft}, ${myTemp}, ${de_pol}, ${de_old}, ${de_diff}" title "step, dt, E0, E, Q, temp, de_pol, de_old, de_diff" file log.csv screen no

run 5000
