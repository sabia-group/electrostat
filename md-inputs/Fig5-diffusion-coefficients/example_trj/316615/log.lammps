pair_coeff 1 1 0.61185 4.38
pair_coeff 2 2 0.08604 3.41
pair_coeff 3 3 0.43738 5.04
pair_coeff 4 4 1.12572 5.06
pair_coeff 5 5 0.05497 3.37
pair_coeff 6 6 0.05497 3.37

bond_coeff 1 200 2.7076
bond_coeff 2 200 3.8213

angle_coeff 1  200 116.035


#groups
group ele type 5 6
2496 atoms in group ele
group top type 6
1248 atoms in group top
group bot type 5
1248 atoms in group bot
group bmi type 1 2 3
960 atoms in group bmi
group electrolyte type 1 2 3 4
1280 atoms in group electrolyte

# settings
variable temp0 equal 500.0
variable eta equal 1.979
timestep 2.0

# basic fixes
fix nvt electrolyte nvt temp ${temp0} ${temp0} 100
fix nvt electrolyte nvt temp 500 ${temp0} 100
fix nvt electrolyte nvt temp 500 500 100
fix shake bmi shake 1e-4 20 0 b 1 2 a 1
Finding SHAKE clusters ...
       0 = # of size 2 clusters
       0 = # of size 3 clusters
       0 = # of size 4 clusters
     320 = # of frozen angles
  find clusters CPU = 0.001 seconds

variable q atom q
compute qtop top reduce sum v_q
compute qbot bot reduce sum v_q
compute ctemp electrolyte temp

# log and log to csv
thermo_style custom step c_ctemp epair etotal c_qbot c_qtop
thermo 10000
variable s equal step
variable t equal c_ctemp
variable e equal epair
variable qtop equal c_qtop
fix fxprint all print 100 "${s} ${t} ${e} ${qtop}" file log.csv screen no

# dumps
dump            trajectory electrolyte xyz 100 positions.xyz
dump_modify     trajectory element N N N F C C
dump            lammpstrj electrolyte custom 100 dump.lammpstrj id type xu yu zu vx vy vz

variable efield equal 0.0/lz
fix fxe ele electrode/efield/thermo ${efield} eta ${eta} temp ${temp0} 100 ${seed} qtotal 0.0 offset_group bot sub_groups bot top algo mat_inv read_inv inv.csv
fix fxe ele electrode/efield/thermo 0 eta ${eta} temp ${temp0} 100 ${seed} qtotal 0.0 offset_group bot sub_groups bot top algo mat_inv read_inv inv.csv
fix fxe ele electrode/efield/thermo 0 eta 1.979 temp ${temp0} 100 ${seed} qtotal 0.0 offset_group bot sub_groups bot top algo mat_inv read_inv inv.csv
fix fxe ele electrode/efield/thermo 0 eta 1.979 temp 500 100 ${seed} qtotal 0.0 offset_group bot sub_groups bot top algo mat_inv read_inv inv.csv
fix fxe ele electrode/efield/thermo 0 eta 1.979 temp 500 100 7 qtotal 0.0 offset_group bot sub_groups bot top algo mat_inv read_inv inv.csv

run 500000

