# electrodes with electrostat
# for graphene-ionic liquid supercapacitor
boundary p p p # periodic calculation
include step_settings.lmp # data_file, seed
variable data_file string data_7.lammps
variable seed equal 7
include settings.lmp # styles, groups, computes and fixes
# set boundary in main script because ffield is periodic
units real
# distribute electrode atoms among all processors:
if "$(extract_setting(world_size) % 2) == 0" then "processors * * 2"
processors * * 2

atom_style full
pair_style lj/cut/coul/long 15
pair_modify mix arithmetic
bond_style harmonic
angle_style harmonic
kspace_style pppm/electrode 1e-6
# kspace_modify in main script because ffield is periodic

read_data ${data_file}
read_data data_7.lammps
