variable data string "../data/vacuum.data"
boundary p p p # slab calculation
include settings.lmp # styles, groups, computes and fixes

#variable dist equal bound(right,zmin)-bound(left,zmax) # distance between electrodes
#print "Distance ${dist}"
variable C0 equal 0.08846
variable area equal (xhi-xlo)*(yhi-ylo)
variable eps0 equal 0.005526349361802015
variable dist_eff equal v_eps0*v_area/v_C0
print "Distance ${dist_eff}"
variable dfield equal -0.1*${dist_eff}/vol # aim for a capacitor charge of .1 e


fix fx ele electrode/dfield ${dfield} eta ${eta} offset_group left algo mat_inv qtotal 0

dump 1 ele custom 1 ../csvs/dfield_vacuum.csv id z q
run 0
