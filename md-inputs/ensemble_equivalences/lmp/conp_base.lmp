variable data string "../data/base.data"
boundary p p f # slab calculation
include settings.lmp # styles, groups, computes and fixes
kspace_modify slab 4.0

fix fx left electrode/conp -2.0 couple right 0.0 eta ${eta} algo mat_inv qtotal 0

dump 1 ele custom 1 ../csvs/conp_base.csv id z q
dump 2 elyt custom 1 ../dump_force/conp_base.csv id fx fy fz
dump 3 all custom 1 ../csvs_all/conp_base.csv id type z q
run 0
