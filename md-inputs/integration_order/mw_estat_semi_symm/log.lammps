LAMMPS (29 Aug 2024 - Development - stable_11Aug2017-28132-gb51df933d9-modified)
OMP_NUM_THREADS environment is not set. Defaulting to 1 thread. (src/comm.cpp:99)
  using 1 OpenMP thread(s) per MPI task

boundary p p p
variable dt        equal 1.0                 # time step [fs],
timestep ${dt}
timestep 1
include settings.mod # styles, groups, computes and fixes
units real
WARNING: Changing timestep from 1 to 1 due to changing units to real (src/update.cpp:318)
# distribute electrode atoms among all processors:
if "$(extract_setting(world_size) % 2) == 0" then "processors * * 2"
processors * * 2

atom_style full
pair_style lj/cut/coul/long 15
bond_style harmonic
angle_style harmonic
kspace_style pppm/electrode 1e-7

read_data "equi.data"
