# ----------------- Init Section -----------------

atom_style    full
units         real
boundary      p p p
kspace_style  pppm/electrode 1e-4
pair_style    lj/cut/coul/long 8 8
bond_style    harmonic
angle_style   harmonic
if "$(extract_setting(world_size) % 2) == 0" then "processors * * 2"

# ----------------- Atom Definition Section -----------------

read_data "data.in"

# ----------------- Settings Section -----------------

# Palladium
pair_coeff 1 1 6.15 2.5114
pair_coeff 2 2 6.15 2.5114
# SPC/E water
pair_coeff 3 3 0.0 0.0
pair_coeff 4 4 0.1553 3.166
# Lithium chloride Joung-Cheatham parameters
pair_coeff 5 5 0.3367 1.409 # Li
pair_coeff 6 6 0.0128 4.830 # Cl

bond_coeff 1 600.0 1.0
angle_coeff 1 75.0 109.47

group bottom_ele type 2
group top_ele type 1
group water type 3:4
group salt type 5:6
group ele union bottom_ele top_ele
group elyt union water salt

fix fRattleSPCE water shake 0.0001 10 0 b 1 a 1
pair_modify mix arithmetic

# ----------------- Run Section -----------------

neigh_modify every 1 delay 0
timestep 2.0
fix fxnvt      elyt nvt temp 300 300 100
#fix fxnvt      water nvt temp 300 300 100
fix fxforce_bot bottom_ele setforce 0.0 0.0 0.0
fix fxforce_top top_ele setforce 0.0 0.0 0.0

# PLUMED
fix fxplumed all plumed plumedfile plumed.dat outfile p.out

# maintain constant potential during equilibration
# FIX: algo cg seems not to work with ffield on - the deposited charge does not correspond to the p p f Siepmann-Sprik case
# -> not using algo cg 

variable efield0 equal -1.0/lz
fix es ele electrode/efield/thermo v_efield0 eta 1.979 temp 300 100 7 qtotal 0.0 offset_group bottom_ele sub_groups bottom_ele top_ele algo mat_inv

# setup output and run
variable q atom q
compute qbot bottom_ele reduce sum v_q
compute qtop top_ele reduce sum v_q
compute temp_mobile water temp
variable s equal step
thermo_style custom step c_temp_mobile c_qbot c_qtop
thermo 10
dump            trajectory all xyz 100 positions.xyz
dump_modify     trajectory element Pd Pd H O Li Cl
run 100000
write_data "data.final"
