# electrodes with electrostat 
# for graphene-ionic liquid supercapacitor
boundary p p p # periodic calculation
include settings.lmp # data_file, seed
variable data_file string data_197.lammps
variable seed equal 197
# set boundary in main script because ffield is periodic
units real
# distribute electrode atoms among all processors:
if "$(extract_setting(world_size) % 2) == 0" then "processors * * 2"

atom_style full
pair_style lj/cut/coul/long 15
pair_modify mix arithmetic
bond_style harmonic
angle_style harmonic
kspace_style pppm/electrode 1e-6
# kspace_modify in main script because ffield is periodic

read_data ${data_file}

pair_coeff 1 1 0.61185 4.38
pair_coeff 2 2 0.08604 3.41
pair_coeff 3 3 0.43738 5.04
pair_coeff 4 4 1.12572 5.06
pair_coeff 5 5 0.05497 3.37
pair_coeff 6 6 0.05497 3.37

bond_coeff 1 200 2.7076
bond_coeff 2 200 3.8213

angle_coeff 1  200 116.035


#groups
group ele type 5 6
group top type 6
group bot type 5
group bmi type 1 2 3
group electrolyte type 1 2 3 4

# settings
variable temp0 equal 500.0
variable eta equal 1.979 
timestep ${dt}

# basic fixes
fix nve electrolyte nve
# fix nvt electrolyte nvt temp ${temp0} ${temp0} 100
fix shake bmi shake 1e-4 20 0 b 1 2 a 1

variable q atom q
compute qtop top reduce sum v_q
compute qbot bot reduce sum v_q
compute ctemp electrolyte temp

# log and log to csv
thermo_style custom step c_ctemp epair etotal c_qbot c_qtop
thermo 1000
variable s equal step
variable t equal c_ctemp
variable e equal epair
variable qtop equal c_qtop

variable efield0 equal -2.0/lz
fix fxele ele electrode/efield/thermo ${efield0} eta ${eta} temp ${temp0} 100 ${seed} qtotal 0.0 offset_group bot sub_groups bot top algo mat_inv read_inv inv.csv

variable efield equal f_fxele[1]
variable de_pol equal f_fxele[2]
variable de_old equal f_fxele[3]
variable de_diff equal v_de_pol-v_de_old
variable myTemp equal c_ctemp
variable qleft equal c_qbot

fix fxprint all print 10 "${s}, ${dt}, ${efield0}, ${efield}, ${qleft}, ${myTemp}, ${de_pol}, ${de_old}, ${de_diff}" title "step, dt, E0, E, Q, temp, de_pol, de_old, de_diff" file log.csv screen no

run 5000
