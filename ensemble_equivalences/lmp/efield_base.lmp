variable data string "../data/base.data"
boundary p p p # slab calculation
include settings.lmp # styles, groups, computes and fixes

variable efield equal -2.0/lz

fix fx ele electrode/efield ${efield} eta ${eta} offset_group left algo mat_inv qtotal 0

dump 1 ele custom 1 ../csvs/efield_base.csv id z q
dump 2 elyt custom 1 ../dump_force/efield_base.csv id fx fy fz
dump 3 all custom 1 ../csvs_all/efield_base.csv id type z q
run 0
