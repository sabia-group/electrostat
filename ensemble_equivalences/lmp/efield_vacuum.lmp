variable data string "../data/vacuum.data"
boundary p p p # slab calculation
include settings.lmp # styles, groups, computes and fixes

variable efield equal -2.0/lz

fix fx ele electrode/efield ${efield} eta ${eta} offset_group left algo mat_inv qtotal 0

dump 1 ele custom 1 ../csvs/efield_vacuum.csv id z q
dump 2 elyt custom 1 ../dump_force/efield_vacuum.csv id fx fy fz
run 0
